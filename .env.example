DEFAULT_BACKEND_ROOT=/api/v1
BACKEND_URL=http://localhost:8080${DEFAULT_BACKEND_ROOT}
JWT_SECRET_ACCESS=<access_token>
JWT_SECRET_REFRESH=<referesh_token>
JWT_LIFETIME=60m

MAIL_SENDER_USERNAME=email_address_for@sending.mails # Specify the email address from which the mails will be sent
MAIL_SENDER_PASSWORD=email_password 

RABBITMQ_DEFAULT_USER=rmuser
RABBITMQ_DEFAULT_PASS=rmpassword
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:${RABBITMQ_PORT}/

RABBITMQ_EXCHANGE=main.exchange
RABBITMQ_JOB_QUEUE=queue.convert.job
RABBITMQ_RESULT_QUEUE=queue.result

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

MINIO_BUCKET_AUDIO_TEMP=audio-temp
MINIO_BUCKET_MUSICXML=musicxml

POSTGRES_DB_NAME=tabit
POSTGRES_DB_PORT=5432
POSTGRES_URL=jdbc:postgresql://db:${POSTGRES_DB_PORT}/${POSTGRES_DB_NAME}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password